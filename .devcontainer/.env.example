# 必須: dockerfiles/のDockerfileを指定
DOCKERFILE_NAME=Dockerfile

# 必須: プロジェクトのフォルダ名（devcontainer.json の workspaceFolder と一致させる）
PROJECT_NAME=my-project

# ==========================================
# ビルド時・ベースイメージ関連
# ==========================================

# 各種ツール・ライブラリのバージョンやURL
PLAYWRIGHT_VERSION=1.52.0
NODE_MAJOR_VERSION=22
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
GITLEAKS_VERSION=8.30.0

# PlatformIO グローバルライブラリ（m5.Dockerfile用）
# 複数指定する場合はスペース区切りで記述します（バージョン指定やGit URLも可）
# 例: PIO_LIBRARIES="m5stack/M5Unified bblanchon/ArduinoJson@^7.0.0 fastled/FastLED"
PIO_LIBRARIES=m5stack/M5Unified

# ==========================================
# ネットワーク・デバイス・実行ユーザー設定
# ==========================================
# 推論サーバーのホスト名とIPアドレス
INFER_HOST=dev-infer.local
DEV_INFER_IP=192.168.1.100

# フロントエンド開発 / noVNC 等のポート
APP_PORT=5173
NOVNC_PORT=6080

# M5Stack等と通信する際のシリアルデバイスパス
# 接続しない場合は /dev/null、接続時は /dev/ttyUSB0 などを指定
SERIAL_DEVICE=/dev/null

# 実行ユーザー (root もしくは vscode, node 等ベースイメージに依存)
CONTAINER_USER=root

# ホスト側のCaddyルート証明書パス（initialize.sh で自動設定されます）
# HOST_CA_CERT_PATH=/etc/caddy/certs/ca.crt
